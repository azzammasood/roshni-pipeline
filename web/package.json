{
  "name": "roshni-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "sync-data": "node scripts/sync-data.mjs",
    "sync-data:fixtures": "node scripts/sync-data.mjs --from fixtures/v1",
    "make-fixtures": "node scripts/make-fixtures.mjs",
    "gen:types": "node scripts/gen-types.mjs",
    "check:types": "node scripts/gen-types.mjs --check",
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "check:equity": "node scripts/check-equity-numbers.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "i18n:review": "node scripts/i18n-review.mjs"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.14.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "json-schema-to-typescript": "^16.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
