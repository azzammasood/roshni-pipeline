{
  "$defs": {
    "CircleMonth": {
      "additionalProperties": false,
      "properties": {
        "circle": {
          "description": "IESCO circle as printed in the press releases",
          "title": "Circle",
          "type": "string"
        },
        "window_hours": {
          "title": "Window Hours",
          "type": "number"
        },
        "windows": {
          "title": "Windows",
          "type": "integer"
        }
      },
      "required": [
        "circle",
        "windows",
        "window_hours"
      ],
      "title": "CircleMonth",
      "type": "object"
    },
    "MaintenanceMonth": {
      "additionalProperties": false,
      "properties": {
        "feeders": {
          "description": "Distinct feeders (code, else printed name)",
          "title": "Feeders",
          "type": "integer"
        },
        "first_date": {
          "format": "date",
          "title": "First Date",
          "type": "string"
        },
        "item": {
          "description": "Listing-page row: a circle, gso or construction",
          "title": "Item",
          "type": "string"
        },
        "last_date": {
          "format": "date",
          "title": "Last Date",
          "type": "string"
        },
        "month": {
          "description": "YYYY-MM (Asia/Karachi dates as printed)",
          "title": "Month",
          "type": "string"
        },
        "unique_window_hours": {
          "description": "Hours of unique_windows; adds up across rows",
          "title": "Unique Window Hours",
          "type": "number"
        },
        "unique_windows": {
          "description": "Windows not already printed in a circle's file (GSO repeats removed)",
          "title": "Unique Windows",
          "type": "integer"
        },
        "window_hours": {
          "description": "Sum of window lengths, one per feeder window",
          "title": "Window Hours",
          "type": "number"
        },
        "windows": {
          "title": "Windows",
          "type": "integer"
        }
      },
      "required": [
        "month",
        "item",
        "windows",
        "feeders",
        "window_hours",
        "unique_windows",
        "unique_window_hours",
        "first_date",
        "last_date"
      ],
      "title": "MaintenanceMonth",
      "type": "object"
    },
    "MonthlyKeSchedule": {
      "additionalProperties": false,
      "properties": {
        "avg_scheduled_hours": {
          "description": "Average scheduled hours a day across the feeders in the schedule in force",
          "title": "Avg Scheduled Hours",
          "type": "number"
        },
        "changed_in_month": {
          "default": false,
          "description": "A new schedule took effect during the month (value at month end)",
          "title": "Changed In Month",
          "type": "boolean"
        },
        "effective_from": {
          "description": "The schedule in force, effective from this date",
          "format": "date",
          "title": "Effective From",
          "type": "string"
        },
        "feeders": {
          "title": "Feeders",
          "type": "integer"
        },
        "month": {
          "title": "Month",
          "type": "string"
        }
      },
      "required": [
        "month",
        "avg_scheduled_hours",
        "feeders",
        "effective_from"
      ],
      "title": "MonthlyKeSchedule",
      "type": "object"
    },
    "MonthlyShutdowns": {
      "additionalProperties": false,
      "properties": {
        "circles": {
          "items": {
            "$ref": "#/$defs/CircleMonth"
          },
          "title": "Circles",
          "type": "array"
        },
        "first_date": {
          "description": "First outage date in the collected releases",
          "format": "date",
          "title": "First Date",
          "type": "string"
        },
        "last_date": {
          "description": "Last outage date in the collected releases",
          "format": "date",
          "title": "Last Date",
          "type": "string"
        },
        "month": {
          "description": "YYYY-MM (Asia/Karachi outage dates as printed)",
          "title": "Month",
          "type": "string"
        },
        "releases": {
          "title": "Releases",
          "type": "integer"
        },
        "window_hours": {
          "description": "Sum of window lengths, one per feeder window",
          "title": "Window Hours",
          "type": "number"
        },
        "windows": {
          "description": "Planned-shutdown windows announced for the month",
          "title": "Windows",
          "type": "integer"
        }
      },
      "required": [
        "month",
        "windows",
        "window_hours",
        "releases",
        "first_date",
        "last_date",
        "circles"
      ],
      "title": "MonthlyShutdowns",
      "type": "object"
    },
    "National": {
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Karachi date of this build",
          "title": "As Of"
        },
        "basis": {
          "title": "Basis",
          "type": "string"
        },
        "caveat": {
          "title": "Caveat",
          "type": "string"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/PolicyEvent"
          },
          "title": "Events",
          "type": "array"
        },
        "gaps": {
          "items": {
            "type": "string"
          },
          "title": "Gaps",
          "type": "array"
        },
        "monthly_ke": {
          "description": "K-Electric's published schedule per month, from its effective date only",
          "items": {
            "$ref": "#/$defs/MonthlyKeSchedule"
          },
          "title": "Monthly Ke",
          "type": "array"
        },
        "monthly_maintenance": {
          "description": "IESCO announced maintenance per month and listing row (since 1.6.0)",
          "items": {
            "$ref": "#/$defs/MaintenanceMonth"
          },
          "title": "Monthly Maintenance",
          "type": "array"
        },
        "monthly_shutdowns": {
          "description": "IESCO planned shutdowns per month (announced maintenance, not load shedding)",
          "items": {
            "$ref": "#/$defs/MonthlyShutdowns"
          },
          "title": "Monthly Shutdowns",
          "type": "array"
        },
        "reports": {
          "items": {
            "$ref": "#/$defs/NepraReport"
          },
          "title": "Reports",
          "type": "array"
        },
        "series": {
          "items": {
            "$ref": "#/$defs/ReportedHours"
          },
          "title": "Series",
          "type": "array"
        }
      },
      "required": [
        "basis",
        "caveat",
        "gaps",
        "series",
        "reports",
        "events"
      ],
      "title": "National",
      "type": "object"
    },
    "NepraReport": {
      "additionalProperties": false,
      "properties": {
        "report_year": {
          "title": "Report Year",
          "type": "string"
        },
        "source_file": {
          "title": "Source File",
          "type": "string"
        }
      },
      "required": [
        "report_year",
        "source_file"
      ],
      "title": "NepraReport",
      "type": "object"
    },
    "PolicyEvent": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "max_hours": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Max Hours"
        },
        "source_url": {
          "title": "Source Url",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "id",
        "date",
        "summary",
        "max_hours",
        "source_url"
      ],
      "title": "PolicyEvent",
      "type": "object"
    },
    "ReportedHours": {
      "additionalProperties": false,
      "properties": {
        "chosen_report_year": {
          "description": "Report the value comes from (earliest listing)",
          "title": "Chosen Report Year",
          "type": "string"
        },
        "company": {
          "description": "Distribution company as printed by NEPRA, e.g. PESCO",
          "title": "Company",
          "type": "string"
        },
        "fiscal_year": {
          "description": "Pakistan fiscal year, July-June, e.g. 2024-25",
          "title": "Fiscal Year",
          "type": "string"
        },
        "max_reported": {
          "title": "Max Reported",
          "type": "number"
        },
        "min_reported": {
          "title": "Min Reported",
          "type": "number"
        },
        "reported_hours_per_day": {
          "description": "Average daily load-shedding hours the company reported to NEPRA",
          "title": "Reported Hours Per Day",
          "type": "number"
        },
        "reports": {
          "description": "Number of NEPRA reports that list this company and year",
          "title": "Reports",
          "type": "integer"
        },
        "values_disagree": {
          "description": "Reports differ by more than 0.01 h (flagged)",
          "title": "Values Disagree",
          "type": "boolean"
        }
      },
      "required": [
        "company",
        "fiscal_year",
        "reported_hours_per_day",
        "chosen_report_year",
        "reports",
        "min_reported",
        "max_reported",
        "values_disagree"
      ],
      "title": "ReportedHours",
      "type": "object"
    }
  },
  "$id": "https://github.com/azzammasood/roshni-pipeline/schemas/v1/national.json",
  "additionalProperties": false,
  "properties": {
    "data": {
      "$ref": "#/$defs/National"
    },
    "generated_at": {
      "description": "When this export was produced (UTC)",
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "label": {
      "description": "What the numbers are: schedules, or figures reported to the regulator; never measurements",
      "title": "Label",
      "type": "string"
    },
    "last_updated": {
      "description": "Latest source fetch or warehouse build (UTC)",
      "format": "date-time",
      "title": "Last Updated",
      "type": "string"
    },
    "schema_id": {
      "description": "Document type and major version, e.g. roshni/feeders/v1",
      "title": "Schema Id",
      "type": "string"
    },
    "schema_version": {
      "description": "Semantic version of the document schema",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "generated_at",
    "last_updated",
    "label",
    "data"
  ],
  "title": "roshni/national/v1",
  "type": "object"
}
