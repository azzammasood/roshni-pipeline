{
  "$defs": {
    "NewsHeadline": {
      "additionalProperties": false,
      "properties": {
        "first_seen_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "When Roshni's daily fetch first saw it",
          "title": "First Seen At"
        },
        "link": {
          "title": "Link",
          "type": "string"
        },
        "outlet": {
          "title": "Outlet",
          "type": "string"
        },
        "places": {
          "default": [],
          "description": "Places named in the title (1.13.0)",
          "items": {
            "$ref": "#/$defs/NewsPlace"
          },
          "title": "Places",
          "type": "array"
        },
        "published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Publication time from the feed (UTC)",
          "title": "Published At"
        },
        "title": {
          "description": "Headline exactly as the outlet's feed published it",
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "outlet",
        "title",
        "link",
        "published_at",
        "first_seen_at"
      ],
      "title": "NewsHeadline",
      "type": "object"
    },
    "NewsPlace": {
      "additionalProperties": false,
      "description": "A place named in a headline: what the news is about, not a measurement (since 1.13.0).",
      "properties": {
        "confidence": {
          "description": "1.0 exact; fuzzy: RapidFuzz ratio / 100",
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "key": {
          "description": "Distribution company name, or the IBC's area_id",
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "enum": [
            "company",
            "kelectric_ibc"
          ],
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "matched": {
          "description": "The headline's words that matched (normalised)",
          "title": "Matched",
          "type": "string"
        },
        "method": {
          "enum": [
            "exact",
            "fuzzy"
          ],
          "title": "Method",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "key",
        "label",
        "matched",
        "method",
        "confidence"
      ],
      "title": "NewsPlace",
      "type": "object"
    }
  },
  "$id": "https://github.com/azzammasood/roshni-pipeline/schemas/v1/news.json",
  "additionalProperties": false,
  "properties": {
    "data": {
      "items": {
        "$ref": "#/$defs/NewsHeadline"
      },
      "title": "Data",
      "type": "array"
    },
    "generated_at": {
      "description": "When this export was produced (UTC)",
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "label": {
      "description": "What the numbers are: schedules, or figures reported to the regulator; never measurements",
      "title": "Label",
      "type": "string"
    },
    "last_updated": {
      "description": "Latest source fetch or warehouse build (UTC)",
      "format": "date-time",
      "title": "Last Updated",
      "type": "string"
    },
    "schema_id": {
      "description": "Document type and major version, e.g. roshni/feeders/v1",
      "title": "Schema Id",
      "type": "string"
    },
    "schema_version": {
      "description": "Semantic version of the document schema",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "generated_at",
    "last_updated",
    "label",
    "data"
  ],
  "title": "roshni/news/v1",
  "type": "object"
}
