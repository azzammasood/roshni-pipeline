{
  "$defs": {
    "MatchReview": {
      "additionalProperties": false,
      "description": "Why an approximate match was accepted (from the review seed's note; since 1.2.0).",
      "properties": {
        "method": {
          "description": "exact: identical after normalising; fuzzy: name-similarity score below 100",
          "enum": [
            "exact",
            "fuzzy"
          ],
          "title": "Method",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        },
        "reviewed_by": {
          "anyOf": [
            {
              "enum": [
                "rules",
                "llm",
                "claude",
                "owner"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "rules (autoreview.py), llm (OpenRouter), claude, owner; null if automatic",
          "title": "Reviewed By"
        },
        "reviewed_on": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reviewed On"
        }
      },
      "required": [
        "method",
        "reviewed_by",
        "reviewed_on",
        "reason"
      ],
      "title": "MatchReview",
      "type": "object"
    },
    "PlannedShutdown": {
      "additionalProperties": false,
      "properties": {
        "circle_as_printed": {
          "title": "Circle As Printed",
          "type": "string"
        },
        "end_local": {
          "title": "End Local",
          "type": "string"
        },
        "end_utc": {
          "format": "date-time",
          "title": "End Utc",
          "type": "string"
        },
        "feeder_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Feeder Id"
        },
        "feeder_match_state": {
          "enum": [
            "matched",
            "pending_review",
            "unmatched",
            "out_of_scope"
          ],
          "title": "Feeder Match State",
          "type": "string"
        },
        "feeder_name_as_printed": {
          "title": "Feeder Name As Printed",
          "type": "string"
        },
        "flags": {
          "title": "Flags",
          "type": "string"
        },
        "match_confidence": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Match Confidence"
        },
        "match_review": {
          "anyOf": [
            {
              "$ref": "#/$defs/MatchReview"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "outage_date": {
          "format": "date",
          "title": "Outage Date",
          "type": "string"
        },
        "release_no": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Release No"
        },
        "release_period": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Month of the press release as printed, MM/YYYY (since 1.2.0)",
          "title": "Release Period"
        },
        "shutdown_id": {
          "title": "Shutdown Id",
          "type": "string"
        },
        "start_local": {
          "title": "Start Local",
          "type": "string"
        },
        "start_utc": {
          "format": "date-time",
          "title": "Start Utc",
          "type": "string"
        }
      },
      "required": [
        "shutdown_id",
        "release_no",
        "outage_date",
        "start_utc",
        "end_utc",
        "start_local",
        "end_local",
        "circle_as_printed",
        "feeder_name_as_printed",
        "feeder_id",
        "feeder_match_state",
        "match_confidence",
        "flags"
      ],
      "title": "PlannedShutdown",
      "type": "object"
    }
  },
  "$id": "https://github.com/azzammasood/roshni-pipeline/schemas/v1/planned_shutdowns.json",
  "additionalProperties": false,
  "properties": {
    "data": {
      "items": {
        "$ref": "#/$defs/PlannedShutdown"
      },
      "title": "Data",
      "type": "array"
    },
    "generated_at": {
      "description": "When this export was produced (UTC)",
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "label": {
      "description": "What the numbers are: schedules, or figures reported to the regulator; never measurements",
      "title": "Label",
      "type": "string"
    },
    "last_updated": {
      "description": "Latest source fetch or warehouse build (UTC)",
      "format": "date-time",
      "title": "Last Updated",
      "type": "string"
    },
    "schema_id": {
      "description": "Document type and major version, e.g. roshni/feeders/v1",
      "title": "Schema Id",
      "type": "string"
    },
    "schema_version": {
      "description": "Semantic version of the document schema",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "generated_at",
    "last_updated",
    "label",
    "data"
  ],
  "title": "roshni/planned_shutdowns/v1",
  "type": "object"
}
