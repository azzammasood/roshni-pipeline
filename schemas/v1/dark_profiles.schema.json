{
  "$defs": {
    "DarkProfile": {
      "additionalProperties": false,
      "properties": {
        "daily": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "K-Electric: scheduled dark minutes in each local hour 0-23",
          "title": "Daily"
        },
        "effective_from": {
          "format": "date",
          "title": "Effective From",
          "type": "string"
        },
        "feeder_id": {
          "title": "Feeder Id",
          "type": "string"
        },
        "scenario_levels": {
          "anyOf": [
            {
              "additionalProperties": {
                "items": {
                  "type": "integer"
                },
                "type": "array"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "IESCO: per interruption level ('2'..'12'), dark minutes in each local hour 0-23 IF that level is active (the files never say which level applies)",
          "title": "Scenario Levels"
        },
        "source": {
          "enum": [
            "iesco",
            "kelectric"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "feeder_id",
        "source",
        "effective_from"
      ],
      "title": "DarkProfile",
      "type": "object"
    }
  },
  "$id": "https://github.com/azzammasood/roshni-pipeline/schemas/v1/dark_profiles.json",
  "additionalProperties": false,
  "properties": {
    "data": {
      "items": {
        "$ref": "#/$defs/DarkProfile"
      },
      "title": "Data",
      "type": "array"
    },
    "generated_at": {
      "description": "When this export was produced (UTC)",
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "label": {
      "description": "Reminder that the data are schedules, not measurements",
      "title": "Label",
      "type": "string"
    },
    "last_updated": {
      "description": "Latest source fetch or warehouse build (UTC)",
      "format": "date-time",
      "title": "Last Updated",
      "type": "string"
    },
    "schema_id": {
      "description": "Document type and major version, e.g. roshni/feeders/v1",
      "title": "Schema Id",
      "type": "string"
    },
    "schema_version": {
      "description": "Semantic version of the document schema",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "generated_at",
    "last_updated",
    "label",
    "data"
  ],
  "title": "roshni/dark_profiles/v1",
  "type": "object"
}
