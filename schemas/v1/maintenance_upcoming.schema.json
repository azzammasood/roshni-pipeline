          "title": "Repeats Circle Window",
          "type": "boolean"
        },
        "start_local": {
          "title": "Start Local",
          "type": "string"
        },
        "start_utc": {
          "format": "date-time",
          "title": "Start Utc",
          "type": "string"
        },
        "window_id": {
          "title": "Window Id",
          "type": "string"
        }
