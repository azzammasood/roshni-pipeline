{
  "$defs": {
    "Feeder": {
      "additionalProperties": false,
      "properties": {
        "atc_loss_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Atc Loss Pct"
        },
        "category": {
          "anyOf": [
            {
              "enum": [
                "Medium",
                "High",
                "Very High"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Category"
        },
        "circle": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Circle"
        },
        "feeder_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Feeder Code"
        },
        "feeder_id": {
          "title": "Feeder Id",
          "type": "string"
        },
        "grid": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Grid"
        },
        "has_schedule": {
          "title": "Has Schedule",
          "type": "boolean"
        },
        "ibc": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ibc"
        },
        "in_feeder_list": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "In Feeder List"
        },
        "localities": {
          "items": {
            "$ref": "#/$defs/LocalityMatch"
          },
          "title": "Localities",
          "type": "array"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "schedule_match_confidence": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Schedule Match Confidence"
        },
        "schedule_match_method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Schedule Match Method"
        },
        "source": {
          "enum": [
            "iesco",
            "kelectric"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "feeder_id",
        "source",
        "name",
        "feeder_code",
        "circle",
        "grid",
        "ibc",
        "category",
        "atc_loss_pct",
        "in_feeder_list",
        "has_schedule",
        "schedule_match_method",
        "schedule_match_confidence",
        "localities"
      ],
      "title": "Feeder",
      "type": "object"
    },
    "LocalityMatch": {
      "additionalProperties": false,
      "properties": {
        "area_id": {
          "title": "Area Id",
          "type": "string"
        },
        "area_name": {
          "title": "Area Name",
          "type": "string"
        },
        "match_confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Match Confidence",
          "type": "number"
        },
        "match_status": {
          "enum": [
            "auto_exact",
            "accepted"
          ],
          "title": "Match Status",
          "type": "string"
        },
        "review": {
          "anyOf": [
            {
              "$ref": "#/$defs/MatchReview"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "area_id",
        "area_name",
        "match_status",
        "match_confidence"
      ],
      "title": "LocalityMatch",
      "type": "object"
    },
    "MatchReview": {
      "additionalProperties": false,
      "description": "Why an approximate match was accepted (from the review seed's note; since 1.2.0).",
      "properties": {
        "method": {
          "description": "exact: identical after normalising; fuzzy: name-similarity score below 100",
          "enum": [
            "exact",
            "fuzzy"
          ],
          "title": "Method",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        },
        "reviewed_by": {
          "anyOf": [
            {
              "enum": [
                "rules",
                "llm",
                "claude",
                "owner"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "rules (autoreview.py), llm (OpenRouter), claude, owner; null if automatic",
          "title": "Reviewed By"
        },
        "reviewed_on": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reviewed On"
        }
      },
      "required": [
        "method",
        "reviewed_by",
        "reviewed_on",
        "reason"
      ],
      "title": "MatchReview",
      "type": "object"
    }
  },
  "$id": "https://github.com/azzammasood/roshni-pipeline/schemas/v1/feeders.json",
  "additionalProperties": false,
  "properties": {
    "data": {
      "items": {
        "$ref": "#/$defs/Feeder"
      },
      "title": "Data",
      "type": "array"
    },
    "generated_at": {
      "description": "When this export was produced (UTC)",
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "label": {
      "description": "What the numbers are: schedules, or figures reported to the regulator; never measurements",
      "title": "Label",
      "type": "string"
    },
    "last_updated": {
      "description": "Latest source fetch or warehouse build (UTC)",
      "format": "date-time",
      "title": "Last Updated",
      "type": "string"
    },
    "schema_id": {
      "description": "Document type and major version, e.g. roshni/feeders/v1",
      "title": "Schema Id",
      "type": "string"
    },
    "schema_version": {
      "description": "Semantic version of the document schema",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "generated_at",
    "last_updated",
    "label",
    "data"
  ],
  "title": "roshni/feeders/v1",
  "type": "object"
}
