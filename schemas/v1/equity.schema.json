{
  "$defs": {
    "Anomaly": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "feeders": {
          "title": "Feeders",
          "type": "integer"
        },
        "rule": {
          "title": "Rule",
          "type": "string"
        }
      },
      "required": [
        "rule",
        "description",
        "feeders"
      ],
      "title": "Anomaly",
      "type": "object"
    },
    "Correlation": {
      "additionalProperties": false,
      "properties": {
        "n": {
          "title": "N",
          "type": "integer"
        },
        "spearman_rho": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Spearman Rho"
        },
        "unit": {
          "enum": [
            "subdivision",
            "feeder"
          ],
          "title": "Unit",
          "type": "string"
        },
        "x_name": {
          "title": "X Name",
          "type": "string"
        },
        "y_name": {
          "title": "Y Name",
          "type": "string"
        }
      },
      "required": [
        "unit",
        "y_name",
        "x_name",
        "n",
        "spearman_rho"
      ],
      "title": "Correlation",
      "type": "object"
    },
    "Equity": {
      "additionalProperties": false,
      "properties": {
        "anomalies": {
          "items": {
            "$ref": "#/$defs/Anomaly"
          },
          "title": "Anomalies",
          "type": "array"
        },
        "correlations": {
          "items": {
            "$ref": "#/$defs/Correlation"
          },
          "title": "Correlations",
          "type": "array"
        },
        "ibc": {
          "items": {
            "$ref": "#/$defs/IbcEquity"
          },
          "title": "Ibc",
          "type": "array"
        },
        "regulator_review": {
          "anyOf": [
            {
              "$ref": "#/$defs/RegulatorReview"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "NEPRA's order on K-Electric: outage bands from K-Electric data"
        },
        "report": {
          "anyOf": [
            {
              "$ref": "#/$defs/Report"
            },
            {
              "type": "null"
            }
          ]
        },
        "scope_note": {
          "title": "Scope Note",
          "type": "string"
        },
        "subdivisions": {
          "items": {
            "$ref": "#/$defs/SubdivisionEquity"
          },
          "title": "Subdivisions",
          "type": "array"
        }
      },
      "required": [
        "scope_note",
        "ibc",
        "subdivisions",
        "correlations",
        "anomalies",
        "report"
      ],
      "title": "Equity",
      "type": "object"
    },
