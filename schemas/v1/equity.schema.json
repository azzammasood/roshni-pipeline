    "OutageBand": {
      "additionalProperties": false,
      "properties": {
        "above_schedule": {
          "description": "Band starts at or above the category's schedule",
          "title": "Above Schedule",
          "type": "boolean"
        },
        "band": {
          "description": "Average daily outage band as printed by NEPRA, e.g. 10:00-12:00",
          "title": "Band",
          "type": "string"
        },
        "consumers": {
          "title": "Consumers",
          "type": "integer"
        },
        "feeders": {
          "title": "Feeders",
          "type": "integer"
        },
        "lower_minutes": {
          "title": "Lower Minutes",
          "type": "integer"
        },
        "pct_consumers": {
          "title": "Pct Consumers",
          "type": "number"
        },
        "pct_feeders": {
          "description": "As printed by NEPRA",
          "title": "Pct Feeders",
          "type": "number"
        },
        "upper_minutes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
