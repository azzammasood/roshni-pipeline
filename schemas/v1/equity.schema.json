    "RegulatorReview": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "title": "Basis",
          "type": "string"
        },
        "categories": {
          "items": {
            "$ref": "#/$defs/ReviewCategory"
          },
          "title": "Categories",
          "type": "array"
        },
        "order_date": {
          "format": "date",
