  "$id": "https://github.com/azzammasood/roshni-pipeline/schemas/v1/equity.json",
  "additionalProperties": false,
  "properties": {
    "data": {
      "$ref": "#/$defs/Equity"
    },
    "generated_at": {
      "description": "When this export was produced (UTC)",
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "label": {
      "description": "What the numbers are: schedules, or figures reported to the regulator; never measurements",
      "title": "Label",
      "type": "string"
    },
    "last_updated": {
      "description": "Latest source fetch or warehouse build (UTC)",
      "format": "date-time",
      "title": "Last Updated",
      "type": "string"
    },
    "schema_id": {
      "description": "Document type and major version, e.g. roshni/feeders/v1",
      "title": "Schema Id",
      "type": "string"
    },
    "schema_version": {
      "description": "Semantic version of the document schema",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "generated_at",
    "last_updated",
    "label",
    "data"
  ],
  "title": "roshni/equity/v1",
  "type": "object"
}
