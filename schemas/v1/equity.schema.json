        "scheduled_feeders": {
          "title": "Scheduled Feeders",
          "type": "integer"
        },
        "share_12h_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Share 12H Pct"
