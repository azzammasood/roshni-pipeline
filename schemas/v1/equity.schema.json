          "title": "Facts",
          "type": "array"
        },
        "iso_week": {
          "title": "Iso Week",
          "type": "string"
        },
        "narrative": {
          "title": "Narrative",
          "type": "string"
        }
      },
      "required": [
        "iso_week",
        "engine",
        "narrative",
        "facts"
      ],
