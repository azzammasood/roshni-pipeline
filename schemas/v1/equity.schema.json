      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "query_id": {
          "title": "Query Id",
          "type": "string"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "id",
        "value",
        "unit",
        "query_id"
      ],
      "title": "ReportFact",
      "type": "object"
    },
    "ReviewCategory": {
      "additionalProperties": false,
      "properties": {
        "avg_atc_loss_pct": {
          "title": "Avg Atc Loss Pct",
          "type": "integer"
