{
  "$defs": {
    "DbtResults": {
      "additionalProperties": false,
      "properties": {
        "failed": {
          "title": "Failed",
          "type": "integer"
        },
        "passed": {
          "description": "Models, seeds and tests that succeeded",
          "title": "Passed",
          "type": "integer"
        },
        "skipped": {
          "title": "Skipped",
          "type": "integer"
        },
        "warned": {
          "title": "Warned",
          "type": "integer"
        }
      },
      "required": [
        "passed",
        "warned",
        "failed",
        "skipped"
      ],
      "title": "DbtResults",
      "type": "object"
    },
    "FetchDay": {
      "additionalProperties": false,
      "description": "Snapshot activity on one Asia/Karachi day.",
      "properties": {
        "date": {
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "errors": {
          "description": "Failed fetches, not counting links known to be broken",
          "title": "Errors",
          "type": "integer"
        },
        "fetches": {
          "description": "Requests made (documents and news feeds)",
          "title": "Fetches",
          "type": "integer"
        },
        "new_files": {
          "description": "New or changed files stored",
          "title": "New Files",
          "type": "integer"
        }
      },
      "required": [
        "date",
        "fetches",
        "new_files",
        "errors"
      ],
      "title": "FetchDay",
      "type": "object"
    },
    "HealCheck": {
      "additionalProperties": false,
      "description": "The parser-healing check of the newest publish run (`roshni heal`).",
      "properties": {
        "aliases_added": {
          "title": "Aliases Added",
          "type": "integer"
        },
        "checked_at": {
          "format": "date-time",
          "title": "Checked At",
          "type": "string"
        },
        "drifted": {
          "title": "Drifted",
          "type": "integer"
        },
        "healed": {
          "title": "Healed",
          "type": "integer"
        },
        "results": {
          "items": {
            "$ref": "#/$defs/HealWorkbook"
          },
          "title": "Results",
          "type": "array"
        },
        "workbooks": {
          "title": "Workbooks",
          "type": "integer"
        }
      },
      "required": [
        "checked_at",
        "workbooks",
        "drifted",
        "healed",
        "aliases_added",
        "results"
      ],
      "title": "HealCheck",
      "type": "object"
    },
    "HealEval": {
      "additionalProperties": false,
      "description": "Chaos evaluation (`roshni heal-eval`): real workbooks with renamed headers.",
      "properties": {
        "models": {
          "items": {
            "$ref": "#/$defs/HealEvalModel"
          },
          "title": "Models",
          "type": "array"
        },
        "run_on": {
          "format": "date",
          "title": "Run On",
          "type": "string"
        },
        "scenarios": {
          "items": {
            "type": "string"
          },
          "title": "Scenarios",
          "type": "array"
        },
        "workbooks": {
          "title": "Workbooks",
          "type": "integer"
        }
      },
      "required": [
        "run_on",
        "workbooks",
        "scenarios",
        "models"
      ],
      "title": "HealEval",
      "type": "object"
    },
    "HealEvalModel": {
      "additionalProperties": false,
      "properties": {
        "cases": {
          "title": "Cases",
          "type": "integer"
        },
        "failed": {
          "description": "Proposal refused by the checks, or the provider was busy",
          "title": "Failed",
          "type": "integer"
        },
        "healed_but_different": {
          "description": "Healed into different data (should be 0)",
          "title": "Healed But Different",
          "type": "integer"
        },
        "latency_mean_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Latency Mean S"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "recovered": {
          "description": "Healed parse equals the original parse row for row",
          "title": "Recovered",
          "type": "integer"
        },
        "tokens_total": {
          "title": "Tokens Total",
          "type": "integer"
        }
      },
      "required": [
        "model",
        "cases",
        "recovered",
        "healed_but_different",
        "failed",
        "tokens_total",
        "latency_mean_s"
      ],
      "title": "HealEvalModel",
      "type": "object"
    },
    "HealWorkbook": {
      "additionalProperties": false,
      "properties": {
        "item": {
          "description": "Maintenance listing row the workbook was fetched under",
          "title": "Item",
          "type": "string"
        },
        "status": {
          "description": "healthy: parsed without drift; healed: drift repaired by a gated alias; failed: drift found, no proposal passed the gate (rows stay in quarantine)",
          "enum": [
            "healthy",
            "healed",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "item",
        "status"
      ],
      "title": "HealWorkbook",
      "type": "object"
    },
    "Healing": {
      "additionalProperties": false,
      "description": "Self-healing parsers (since 1.10.0): the last check, every learned alias, the eval.",
      "properties": {
        "aliases": {
          "items": {
            "$ref": "#/$defs/LearnedAlias"
          },
          "title": "Aliases",
          "type": "array"
        },
        "eval": {
          "anyOf": [
            {
              "$ref": "#/$defs/HealEval"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_check": {
          "anyOf": [
            {
              "$ref": "#/$defs/HealCheck"
            },
            {
              "type": "null"
            }
          ],
          "description": "None when the heal step did not run"
        }
      },
      "required": [
        "last_check",
        "aliases",
        "eval"
      ],
      "title": "Healing",
      "type": "object"
    },
    "Health": {
      "additionalProperties": false,
      "description": "What the pipeline did (since 1.9.0): publish runs, fetch activity, table sizes, dbt\nresults and quarantine counts. About the pipeline, not about load shedding.",
      "properties": {
        "dbt": {
          "$ref": "#/$defs/DbtResults"
        },
        "fetch_days": {
          "description": "Every day with snapshot activity",
          "items": {
            "$ref": "#/$defs/FetchDay"
          },
          "title": "Fetch Days",
          "type": "array"
        },
        "freshness_target_hours": {
          "description": "The site should never be older than this",
          "title": "Freshness Target Hours",
          "type": "integer"
        },
        "healing": {
          "anyOf": [
            {
              "$ref": "#/$defs/Healing"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Self-healing parsers (1.10.0)"
        },
        "parsed": {
          "items": {
            "$ref": "#/$defs/TableQuality"
          },
          "title": "Parsed",
          "type": "array"
        },
        "publish_runs": {
          "description": "Newest completed runs, oldest first",
          "items": {
            "$ref": "#/$defs/PublishRun"
          },
          "title": "Publish Runs",
          "type": "array"
        },
        "sizes": {
          "description": "One point per publish date, oldest first",
          "items": {
            "$ref": "#/$defs/SizePoint"
          },
          "title": "Sizes",
          "type": "array"
        }
      },
      "required": [
        "freshness_target_hours",
        "dbt",
        "parsed",
        "sizes",
        "publish_runs",
        "fetch_days"
      ],
      "title": "Health",
      "type": "object"
    },
    "LearnedAlias": {
      "additionalProperties": false,
      "properties": {
        "added": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Added"
        },
        "by": {
          "description": "llm-heal <date> <provider/model> | owner | claude",
          "title": "By",
          "type": "string"
        },
        "field": {
          "description": "Field the parser already knows",
          "title": "Field",
          "type": "string"
        },
        "header": {
          "description": "Exact header text, lower case, single spaces",
          "title": "Header",
          "type": "string"
        },
        "parser": {
          "title": "Parser",
          "type": "string"
        }
      },
      "required": [
        "parser",
        "header",
        "field",
        "added",
        "by"
      ],
      "title": "LearnedAlias",
      "type": "object"
    },
    "PublishRun": {
      "additionalProperties": false,
      "description": "One completed run of the daily publish workflow (GitHub Actions).",
      "properties": {
        "conclusion": {
          "description": "success, failure, cancelled, ...",
          "title": "Conclusion",
          "type": "string"
        },
        "duration_seconds": {
          "title": "Duration Seconds",
          "type": "integer"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "trigger": {
          "description": "workflow_run (after the snapshot), schedule or manual",
          "title": "Trigger",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "started_at",
        "duration_seconds",
        "conclusion",
        "trigger",
        "url"
      ],
      "title": "PublishRun",
      "type": "object"
    },
    "QuarantineReason": {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "description": "The parser's reason, up to the first colon",
          "title": "Reason",
          "type": "string"
        },
        "rows": {
          "title": "Rows",
          "type": "integer"
        }
      },
      "required": [
        "reason",
        "rows"
      ],
      "title": "QuarantineReason",
      "type": "object"
    },
    "SizePoint": {
      "additionalProperties": false,
      "description": "Warehouse table sizes on one publish date.",
      "properties": {
        "date": {
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "rows": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Rows",
          "type": "object"
        }
      },
      "required": [
        "date",
        "rows"
      ],
      "title": "SizePoint",
      "type": "object"
    },
    "TableQuality": {
      "additionalProperties": false,
      "description": "A parsed table: rows kept and rows quarantined with a reason.",
      "properties": {
        "quarantined": {
          "title": "Quarantined",
          "type": "integer"
        },
        "rows": {
          "title": "Rows",
          "type": "integer"
        },
        "table": {
          "title": "Table",
          "type": "string"
        },
        "top_reasons": {
          "description": "The three most common reasons",
          "items": {
            "$ref": "#/$defs/QuarantineReason"
          },
          "title": "Top Reasons",
          "type": "array"
        }
      },
      "required": [
        "table",
        "rows",
        "quarantined",
        "top_reasons"
      ],
      "title": "TableQuality",
      "type": "object"
    }
  },
  "$id": "https://github.com/azzammasood/roshni-pipeline/schemas/v1/health.json",
  "additionalProperties": false,
  "properties": {
    "data": {
      "$ref": "#/$defs/Health"
    },
    "generated_at": {
      "description": "When this export was produced (UTC)",
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "label": {
      "description": "What the numbers are: schedules, or figures reported to the regulator; never measurements",
      "title": "Label",
      "type": "string"
    },
    "last_updated": {
      "description": "Latest source fetch or warehouse build (UTC)",
      "format": "date-time",
      "title": "Last Updated",
      "type": "string"
    },
    "schema_id": {
      "description": "Document type and major version, e.g. roshni/feeders/v1",
      "title": "Schema Id",
      "type": "string"
    },
    "schema_version": {
      "description": "Semantic version of the document schema",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "generated_at",
    "last_updated",
    "label",
    "data"
  ],
  "title": "roshni/health/v1",
  "type": "object"
}
