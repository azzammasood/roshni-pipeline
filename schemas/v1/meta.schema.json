{
  "$defs": {
    "Meta": {
      "additionalProperties": false,
      "properties": {
        "attribution": {
          "items": {
            "type": "string"
          },
          "title": "Attribution",
          "type": "array"
        },
        "disclaimer": {
          "title": "Disclaimer",
          "type": "string"
        },
        "documents": {
          "items": {
            "type": "string"
          },
          "title": "Documents",
          "type": "array"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceInfo"
          },
          "title": "Sources",
          "type": "array"
        },
        "timezone_display": {
          "const": "Asia/Karachi",
          "title": "Timezone Display",
          "type": "string"
        },
        "utc_offset_hours": {
          "const": 5,
          "title": "Utc Offset Hours",
          "type": "integer"
        }
      },
      "required": [
        "timezone_display",
        "utc_offset_hours",
        "documents",
        "sources",
        "attribution",
        "disclaimer"
      ],
      "title": "Meta",
      "type": "object"
    },
    "SourceInfo": {
      "additionalProperties": false,
      "properties": {
        "effective_basis": {
          "title": "Effective Basis",
          "type": "string"
        },
        "effective_from": {
          "format": "date",
          "title": "Effective From",
          "type": "string"
        },
        "published_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Published Label"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "source_file": {
          "title": "Source File",
          "type": "string"
        }
      },
      "required": [
        "source",
        "source_file",
        "effective_from",
        "effective_basis",
        "published_label"
      ],
      "title": "SourceInfo",
      "type": "object"
    }
  },
  "$id": "https://github.com/azzammasood/roshni-pipeline/schemas/v1/meta.json",
  "additionalProperties": false,
  "properties": {
    "data": {
      "$ref": "#/$defs/Meta"
    },
    "generated_at": {
      "description": "When this export was produced (UTC)",
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "label": {
      "description": "Reminder that the data are schedules, not measurements",
      "title": "Label",
      "type": "string"
    },
    "last_updated": {
      "description": "Latest source fetch or warehouse build (UTC)",
      "format": "date-time",
      "title": "Last Updated",
      "type": "string"
    },
    "schema_id": {
      "description": "Document type and major version, e.g. roshni/feeders/v1",
      "title": "Schema Id",
      "type": "string"
    },
    "schema_version": {
      "description": "Semantic version of the document schema",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "generated_at",
    "last_updated",
    "label",
    "data"
  ],
  "title": "roshni/meta/v1",
  "type": "object"
}
