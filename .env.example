# Copy to .env (git-ignored). Never commit real values.

# Optional override of the repo root (used inside Docker).
ROSHNI_ROOT=

# Phase 6: narration via OpenRouter (OpenAI-compatible).
OPENROUTER_API_KEY=
ROSHNI_NARRATOR_MODEL=
ROSHNI_NARRATOR_SPEND_CAP_USD=0.50

# Phase 3b: Databricks Free Edition smoke run (dbt-databricks profile via env).
DATABRICKS_HOST=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=
ROSHNI_DATABRICKS_CATALOG=workspace
